# 数据库配置
SQLALCHEMY_DATABASE_URL=postgresql://user:password@localhost/jinli

# 安全配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 调试配置
DEBUG=True
LOG_LEVEL=INFO

# 管理员配置
# 示例管理员EVM地址，多个地址用逗号分隔
ADMIN_EVM_ADDRESSES=0x1234567890123456789012345678901234567890