  "commission_policy_constraints": [
    {
      "conname": "commission_policy_created_by_not_null",
      "contype": "n",
      "def": "NOT NULL created_by"
    },
    {
      "conname": "commission_policy_created_by_rng",
      "contype": "c",
      "def": "CHECK (((created_by >= 0) OR (created_by = ANY (ARRAY[('-1'::integer)::bigint, ('-2'::integer)::bigint, ('-3'::integer)::bigint]))))"
    },
    {
      "conname": "commission_policy_effective_from_not_null",
      "contype": "n",
      "def": "NOT NULL effective_from"
    },
    {
      "conname": "commission_policy_effective_uniq",
      "contype": "u",
      "def": "UNIQUE (effective_from)"
    },
    {
      "conname": "commission_policy_fee_rate_bp_not_null",
      "contype": "n",
      "def": "NOT NULL fee_rate_bp"
    },
    {
      "conname": "commission_policy_fee_rate_rng",
      "contype": "c",
      "def": "CHECK (((fee_rate_bp >= 100) AND (fee_rate_bp <= 500)))"
    },
    {
      "conname": "commission_policy_levels_not_null",
      "contype": "n",
      "def": "NOT NULL levels"
    },
    {
      "conname": "commission_policy_levels_rng",
      "contype": "c",
      "def": "CHECK (((levels >= 1) AND (levels <= 10)))"
    },
    {
      "conname": "commission_policy_pkey",
      "contype": "p",
      "def": "PRIMARY KEY (policy_id)"
    },
    {
      "conname": "commission_policy_policy_id_not_null",
      "contype": "n",
      "def": "NOT NULL policy_id"
    },
    {
      "conname": "commission_policy_time_created_not_null",
      "contype": "n",
      "def": "NOT NULL time_created"
    },
    {
      "conname": "commission_policy_weights_bp_not_null",
      "contype": "n",
      "def": "NOT NULL weights_bp"
    },
    {
      "conname": "commission_policy_weights_len",
      "contype": "c",
      "def": "CHECK ((array_length(weights_bp, 1) = levels))"
    },
    {
      "conname": "commission_policy_weights_nonneg",
      "contype": "c",
      "def": "CHECK ((0 <= ALL (weights_bp)))"
    }
  ],
