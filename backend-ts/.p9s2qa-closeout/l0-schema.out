 "triggers": [
  {
   "tbl": "batt_account",
   "tgname": "trg_batt_account_touch_updated",
   "def": "CREATE TRIGGER trg_batt_account_touch_updated BEFORE UPDATE ON public.batt_account FOR EACH ROW EXECUTE FUNCTION batt_account_touch_updated()"
  },
  {
   "tbl": "batt_entry",
   "tgname": "trg_batt_entry_append_only",
   "def": "CREATE TRIGGER trg_batt_entry_append_only BEFORE DELETE OR UPDATE ON public.batt_entry FOR EACH ROW EXECUTE FUNCTION batt_entry_append_only()"
  },
  {
   "tbl": "checkin_log",
   "tgname": "trg_checkin_log_append_only",
   "def": "CREATE TRIGGER trg_checkin_log_append_only BEFORE DELETE OR UPDATE ON public.checkin_log FOR EACH ROW EXECUTE FUNCTION checkin_log_append_only()"
  },
  {
   "tbl": "checkin_makeup_log",
   "tgname": "trg_checkin_makeup_log_append_only",
   "def": "CREATE TRIGGER trg_checkin_makeup_log_append_only BEFORE DELETE OR UPDATE ON public.checkin_makeup_log FOR EACH ROW EXECUTE FUNCTION checkin_makeup_log_append_only()"
  }
 ],
 "kind_enum": {
  "def": "CHECK ((kind = ANY (ARRAY['mint'::text, 'burn'::text, 'transfer'::text, 'hold'::text, 'hold_release'::text, 'hold_forfeit'::text, 'job_escrow'::text, 'job_escrow_refund'::text, 'job_payout'::text, 'job_fee'::text, 'commission'::text, 'purchase'::text, 'sale'::text, 'purchase_refund'::text, 'trade'::text, 'trade_fee'::text, 'listing_fee'::text, 'listing_deposit'::text, 'currency_create_fee'::text, 'reversal'::text, 'checkin_makeup_fee'::text])))",
