{
  "name": "jinli-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run src/test/unit",
    "test:components": "vitest run src/test/components",
    "test:performance": "vitest run src/test/performance",
    "test:accessibility": "vitest run src/test/accessibility",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "type-check": "tsc --noEmit",
    "optimize": "node scripts/optimize.js",
    "test:all": "./scripts/test.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:prod": "./scripts/deploy.sh --target vercel",
    "deploy:custom": "./scripts/deploy.sh --target custom"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.10",
    "@fullcalendar/interaction": "^6.1.10",
    "@fullcalendar/react": "^6.1.10",
    "@headlessui/react": "^1.7.17",
    "i18next": "^23.8.0",
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.22.0",
    "react-window": "^1.8.9",
    "tailwindcss": "^4.1.13",
    "web3": "^4.4.0",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "axe-core": "^4.8.0",
    "depcheck": "^1.4.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest-axe": "^8.0.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.8",
    "vitest": "^0.34.0"
  }
}
